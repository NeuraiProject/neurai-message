{
  // node16 decides the module format of each declaration file strictly:
  // `import` must get ESM declarations (dist/index.d.mts) and `require`
  // CommonJS ones (dist/index.d.ts in this CommonJS package).
  "extends": "./tsconfig.types-nodenext.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16"
  }
}
